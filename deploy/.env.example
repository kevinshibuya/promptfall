# The box's ~/apps/promptfall/.env, with placeholders. The real values live only on the box.
IMAGE=ghcr.io/kevinshibuya/promptfall:v0.0.0
PREVIOUS_IMAGE=ghcr.io/kevinshibuya/promptfall:v0.0.0
# Bots on the market: 6 for the wave, 0 at the public listing.
PROMPTFALL_BOTS=6
# The GitHub OAuth app's client id (device flow enabled; a client id is not a secret, and no
# client secret is needed). Without it the host starts, and every /promptfall link is refused.
PROMPTFALL_GITHUB_CLIENT_ID=your-github-oauth-app-client-id
# The bearer token of the admin routes (`openssl rand -hex 32`). Empty: the host has no admin routes.
PROMPTFALL_ADMIN_TOKEN=change-me
