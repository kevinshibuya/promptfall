{
  "name": "promptfall",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -b packages/sim packages/protocol packages/ledger servers/fake",
    "typecheck:plugin": "node scripts/plugin-types.mjs && tsc -p plugins/promptfall",
    "test": "pnpm -r --filter './packages/*' --filter './servers/*' test && pnpm test:scripts",
    "test:arc": "pnpm --filter @promptfall/sim test:arc",
    "vendor": "node scripts/vendor.mjs",
    "vendor:check": "node scripts/vendor.mjs && test -z \"$(git status --porcelain -- plugins/promptfall/hooks/vendor plugins/promptfall/hooks/version.ts)\"",
    "build:server": "node scripts/build-server.mjs",
    "fake": "pnpm --filter @promptfall/fake-server start",
    "sprites": "tsx scripts/sprites.ts",
    "sprites:check": "tsx scripts/sprites.ts --check",
    "font": "tsx scripts/font.ts",
    "font:check": "pnpm font && test -z \"$(git status --porcelain -- plugins/promptfall/hooks/windows/glyphs.ts)\"",
    "cues": "tsx scripts/cues.ts",
    "cues:check": "pnpm cues && test -z \"$(git status --porcelain -- plugins/promptfall/cues)\"",
    "content": "tsx scripts/content.ts",
    "content:check": "pnpm content && test -z \"$(git status --porcelain -- .claude/skills/promptfall-content/reference/content.md)\"",
    "slice": "tsx scripts/slice-sheet.ts",
    "grid": "tsx scripts/sprite-grid.ts",
    "contact": "tsx scripts/contact.ts",
    "backdrop": "tsx scripts/backdrop.ts",
    "test:scripts": "vitest run scripts",
    "stage:goldens": "tsx scripts/stage-goldens.ts",
    "stage:parity": "tsx scripts/stage-parity.ts",
    "smoke:desktop": "tsx scripts/smoke-desktop.ts",
    "svg:measure": "tsx scripts/svg-measure.ts",
    "refsheet": "tsx scripts/ref-sheet.ts",
    "readme:images": "tsx scripts/readme-images.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@promptfall/ledger": "workspace:*",
    "@promptfall/sim": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "fflate": "0.8.2",
    "opentype.js": "^2.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tsup": "8.5.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.3"
  }
}
